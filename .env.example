# Strato FTP/SFTP Zugangsdaten — KOPIEREN zu .env (gitignored).
# Diese Werte stehen im Strato-Kundenpanel unter "FTP/SFTP" oder "Webspace".

# FTP-Hostname, z.B. ssh.strato.de oder dein Domain-Name
STRATO_HOST=ssh.strato.de

# FTP-Benutzername (bei Strato meist die Domain selbst, z.B. fahrschule-nicolai.de)
STRATO_USER=fahrschule-nicolai.de

# FTP-Passwort (Strato-Hauptpasswort oder dediziertes FTP-Passwort)
STRATO_PASS=

# SSH-Port (22 für SFTP, 21 für FTP)
STRATO_PORT=22

# Protokoll: sftp (empfohlen) oder ftp
STRATO_PROTOCOL=sftp

# Remote Webroot — der Pfad auf dem Strato-Server zur Webseite.
# Üblicherweise /www, /htdocs oder einfach /
STRATO_REMOTE_PATH=/

# ---------------------------------------------------------------------------
# SEO — Build-Zeit-Variablen (werden von Vite ins statische HTML gebacken).
# Nur nötig, wenn die jeweiligen Werte gesetzt werden sollen; leer = weglassen.
# Nach dem Setzen: `npm run build` neu ausführen und dist/ hochladen.
# ---------------------------------------------------------------------------

# Sterne-Bewertung im DrivingSchool-Schema (Rich Result mit Sternen bei Google).
# ERST befüllen, wenn genügend echte Google-Bewertungen vorliegen (Richtwert:
# >= 5). NUR aktiv, wenn BEIDE Werte gesetzt sind. Zahlen wie im GBP-Profil.
VITE_GBP_RATING_AVG=
VITE_GBP_RATING_COUNT=

# Verifizierungs-Tokens (nur Startseite). Aus GSC bzw. Bing Webmaster Tools.
VITE_GSC_TOKEN=
VITE_BING_TOKEN=
